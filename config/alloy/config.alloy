local.file_match "app_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/moysklad-trainee/application.*.json.log",
      "app"      = "moysklad-trainee",
      "env"      = "local",
    },
  ]
  sync_period = "5s"
}

loki.source.file "app_scraper" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.spring_boot_json.receiver]
}

loki.process "spring_boot_json" {
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
